; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Sanctuary Defenders"
config/description="Hybrid RPG Tower Defense"
config/version="0.0.1"
run/main_scene="res://src/scenes/MainMenu.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
run/flush_stdout_on_print=true

[autoload]

GEventBus="*res://src/foundation/event_bus/event_bus.gd"
GSavePersistence="*res://src/foundation/save_persistence/save_persistence.gd"
GGrid="*res://src/foundation/grid/grid.gd"
GPathfindingSystem="*res://src/foundation/pathfinding/pathfinding_system.gd"
GGameDataRegistry="*res://src/core/game_data_registry.gd"
GSceneManager="*res://src/core/scene_manager.gd"
GWaveManager="*res://src/gameplay/wave_manager.gd"
GMissionEconomy="*res://src/core/mission_economy.gd"
GInventory="*res://src/core/inventory/inventory.gd"
GDefenseBuilding="*res://src/core/defense_building/defense_building.gd"
GMenagerie="*res://src/core/menagerie/menagerie.gd"
GMissionSelect="*res://src/core/mission_select/mission_select.gd"
GHeroSkillBuild="*res://src/core/hero_skill_build/hero_skill_build.gd"
GAudioSystem="*res://src/core/audio/audio_system.gd"
GEncyclopedia="*res://src/core/encyclopedia/encyclopedia.gd"
_mcp_game_helper="*res://addons/godot_ai/runtime/game_helper.gd"

[internationalization]

locale/translations=PackedStringArray("res://assets/localization/strings.en.translation")

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[editor_plugins]

enabled=PackedStringArray("res://addons/gdUnit4/plugin.cfg", "res://addons/godot_ai/plugin.cfg")

