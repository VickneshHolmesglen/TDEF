[resource]
script = ExtResource("1")
upgrade_id = &"upgrade_habitat_expansion_bountiful"
target_structure_id = &"habitat_expansion_tier_2"
prerequisite_upgrade_id = &""
requirements = {
&"equipment": &"iron_greaves",
&"creature": &"mossback_toad"
}
